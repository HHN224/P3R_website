<div class="post-list"><% if(!posts.length){ %><div class="empty-state"><span>NO ENTRIES FOUND</span><h2>暂时没有找到这段记忆。</h2><p>换一个关键词，或看看其他文章。</p><a class="button" href="/journal">查看全部文章 ↗</a></div><% } %>
<% for(const p of posts){ %><article class="post-row"><div class="post-date"><strong><%= p.date.slice(5).replace('-','.') %></strong><span><%= p.date.slice(0,4) %></span></div><div class="post-copy"><div class="post-meta"><span><%= p.category %></span><span><%= p.minutes %> MIN READ</span><% if(p.series){ %><span>DAY <%= String(p.day).padStart(2,'0') %></span><% } %></div><a class="post-title" href="<%= postUrl(p) %>"><h2><%= p.title %></h2><span>↗</span></a><p><%= p.excerpt %></p><div class="post-tags"><% for(const tag of p.tags){ %><a href="/journal?tag=<%= encodeURIComponent(tag) %>"># <%= tag %></a><% } %></div></div></article><% } %></div>
