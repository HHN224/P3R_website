# 统一编辑器基础格式，不参与构建，也不影响运行逻辑
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# 代码与模板沿用仓库现有的两空格缩进（已核对：全仓库无 Tab 缩进）
[*.{mjs,js,ejs,css,html}]
indent_style = space
indent_size = 2
