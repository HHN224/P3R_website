<%- include('head') %><%- include('header') %><div class="reading-progress" id="reading-progress"></div><main id="main" class="page-container article-container"><a class="back-link" href="<%= withBase('/journal') %>">← 返回文章手记</a><div class="article-grid"><article><header class="article-header"><p class="eyebrow"><%= post.category %> / <%= post.date %> / <%= post.minutes %> MIN READ</p><h1><%= post.title %></h1><p class="article-deck"><%= post.excerpt %></p><div class="post-tags"><% for(const t of post.tags){ %><a href="<%= withBase('/journal') %>?tag=<%= encodeURIComponent(t) %>"># <%= t %></a><% } %></div></header><div class="prose"><%- html %></div><div class="article-end"><span>END OF ENTRY <b>✦</b></span><button id="copy-link">复制文章链接 ↗</button></div>
<% if(peers.length>1){ const idx=peers.findIndex(p=>p.slug===post.slug); %><nav class="article-pagination" aria-label="系列前后篇"><% if(idx>0){ %><a href="<%= postUrl(peers[idx-1]) %>"><small>← 上一篇 / DAY <%= peers[idx-1].day %></small><strong><%= peers[idx-1].title %></strong></a><% } %><% if(idx<peers.length-1){ %><a href="<%= postUrl(peers[idx+1]) %>"><small>下一篇 / DAY <%= peers[idx+1].day %> →</small><strong><%= peers[idx+1].title %></strong></a><% } %></nav><% } %></article>
<aside class="article-aside"><details class="toc" open><summary>ON THIS PAGE <span>文章目录</span></summary><nav aria-label="文章目录"><% for(const item of toc){ %><a class="<%= item.level %>" href="#<%= item.id %>"><%= item.title %></a><% } %></nav></details><% if(peers.length){ %><div class="series-toc"><span class="micro"><%= post.series %></span><% for(const p of peers){ %><a href="<%= postUrl(p) %>" <% if(p.slug===post.slug){ %>aria-current="page"<% } %>><b><%= String(p.day).padStart(2,'0') %></b><span><%= p.title.split('：')[0] %></span></a><% } %></div><% } %><a href="#main" class="back-link">↑ 回到顶部</a></aside></div></main><%- include('footer') %>
